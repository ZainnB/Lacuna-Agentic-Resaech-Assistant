# Copy to .env and fill in. .env is gitignored; never commit keys or paste them into chat.
# Every provider below has a free tier that needs no payment method.

SPEND_STAGE=0

POSTGRES_DSN=postgresql://lacuna:lacuna@localhost:5433/lacuna
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lacuna-dev

# Paper APIs
OPENALEX_API_KEY=            # https://openalex.org -> account -> API key. Free, $1/day of usage.
S2_API_KEY=                  # https://www.semanticscholar.org/product/api#api-key-form (arrives by email)
CONTACT_EMAIL=               # optional; sent to OpenAlex/arXiv as a courtesy header

# Free-tier LLM providers (a missing key just drops that provider from the chain)
GROQ_API_KEY=                # https://console.groq.com
GEMINI_API_KEY=              # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=          # https://openrouter.ai/keys  (optional)
CEREBRAS_API_KEY=            # optional; the trial needs a card, so leave empty
OLLAMA_BASE_URL=http://localhost:11434/v1   # optional local fallback
